@{
  var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@(string.IsNullOrEmpty(title) ? "Podróże Małe i Duże" : $"{title} · Podróże Małe i Duże")</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600;800&display=swap"
        rel="stylesheet">
  <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true"/>
  <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true"/>
</head>
<body>

<header class="header">
  <a asp-controller="Home" asp-action="Index" class="logo">
    <svg viewBox="0 0 32 32" fill="none" stroke="#F8B97A" stroke-width="1.6">
      <circle cx="16" cy="16" r="7.5"/>
      <ellipse cx="16" cy="16" rx="14" ry="4.6" transform="rotate(-18 16 16)"/>
    </svg>
    <span>Podróże Małe i Duże</span>
  </a>
  <a asp-controller="Home" asp-action="Index" class="nav-btn">
    Strona główna
    <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round"
                           stroke-linejoin="round"><path d="M4 11 12 4l8 7M6 9.5V20h12V9.5"/></svg></span>
  </a>
</header>

<main class="auth">
  <canvas id="bgGlobe" data-globe aria-hidden="true"></canvas>

  @RenderBody()
</main>

<partial name="_Footer"/>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>