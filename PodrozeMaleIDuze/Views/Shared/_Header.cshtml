@using PodrozeMaleIDuze.Constants
@* Nagłówek dla _Layout. Zawartość prawej strony zależy od tego,
   czy użytkownik jest zalogowany (User.Identity.IsAuthenticated). *@
@{
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name ?? string.Empty;
    var initial = string.IsNullOrEmpty(userName) ? "?" : userName[..1].ToUpper();
}

<header class="header">
    <a asp-controller="Home" asp-action="Index" class="logo">
        <svg viewBox="0 0 32 32" fill="none" stroke="#F8B97A" stroke-width="1.6">
            <circle cx="16" cy="16" r="7.5"/>
            <ellipse cx="16" cy="16" rx="14" ry="4.6" transform="rotate(-18 16 16)"/>
        </svg>
        <span>Podróże Małe i Duże</span>
    </a>

    <nav class="nav">
        <a asp-controller="Map" asp-action="Index" class="nav-pill nav-pill-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 4 3 6.5v13.5L9 17.5l6 2.5 6-2.5V4L15 6.5 9 4ZM9 4v13.5M15 6.5V20"/>
            </svg>
            Mapa
        </a>

        @if (isLoggedIn)
        {
            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                @if (User.IsInRole(Roles.Admin))
                {
                    <a asp-controller="AdminPanel" asp-action="Index" class="nav-pill nav-pill-outline">Panel admina</a>
                }
                <button type="submit" class="nav-link-btn">Wyloguj</button>
            </form>

            <span class="nav-user">
                <span>@userName</span>
                <span class="avatar">@initial</span>
            </span>
        }
        else
        {
            <a asp-controller="Account" asp-action="Register" class="nav-pill nav-pill-outline">Załóż konto</a>

            <a asp-controller="Account" asp-action="Login" class="nav-btn">
                Zaloguj
                <span class="ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round">
                        <circle cx="12" cy="8.5" r="3.5"/>
                        <path d="M5 20c1.2-3.6 4-5.5 7-5.5s5.8 1.9 7 5.5"/>
                    </svg>
                </span>
            </a>
        }
    </nav>
</header>
