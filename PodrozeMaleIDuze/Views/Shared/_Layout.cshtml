@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) => current == controller ? "active" : "";
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - PodrozeMaleIDuze</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;500;700&display=swap" rel="stylesheet">

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/PodrozeMaleIDuze.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg app-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="logo-placeholder">LOGO</span>
                <span class="brand-name">PodrozeMaleIDuze</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @Active("Home")" asp-area="" asp-controller="Home" asp-action="Index">Strona
                            główna</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Map")" asp-area="" asp-controller="Map" asp-action="Index">Mapa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Saved")" asp-area="" asp-controller="Saved" asp-action="Index">Zapisane
                            miejsca</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Active("Trips")" asp-area="" asp-controller="Trips" asp-action="Index">Zrobione
                            trasy</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link nav-login @Active("Account")" asp-area="" asp-controller="Account"
                           asp-action="Login">Zaloguj się</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="app-footer">
    <div class="container">
        &copy; 2026 - PodrozeMaleIDuze -
        <a asp-area="" asp-controller="Home" asp-action="Privacy">Polityka prywatności</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>