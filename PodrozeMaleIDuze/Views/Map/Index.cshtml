@using PodrozeMaleIDuze.Constants
@model PodrozeMaleIDuze.Models.ViewModels.Map.MapViewModel
@{
    Layout = "_MapLayout";
    ViewData["Title"] = "Mapa miejsc";
    var isCityAdmin = User.IsInRole(Roles.CityAdmin);
    var userName = User.Identity?.Name ?? string.Empty;
    var initial = string.IsNullOrEmpty(userName) ? "?" : userName[..1].ToUpper();
    var citiesText = Model.ManagedCities.Count > 0 ? string.Join(", ", Model.ManagedCities) : "brak";
}

<div class="map-wrap">
    <div id="map"></div>

    @if (isCityAdmin)
    {
        <a class="map-brand" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 32 32" fill="none" stroke="#F8B97A" stroke-width="1.6">
                <circle cx="16" cy="16" r="7.5"/>
                <ellipse cx="16" cy="16" rx="14" ry="4.6" transform="rotate(-18 16 16)"/>
            </svg>
            <span>Podróże Małe i Duże</span>
        </a>
        <div class="map-legend" id="legend"></div>
    }
</div>

@if (isCityAdmin)
{
    <aside class="panel ca">
        <section class="me-card">
            <span class="av">@initial</span>
            <div class="me-info">
                <b>@userName</b>
                <span class="role-badge">Admin miasta</span>
                <small>Miasta: @citiesText</small>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn">Wyloguj</button>
            </form>
        </section>

        <h1>Mapa miejsc</h1>
        <p class="count" id="count"></p>

        <section id="cityAdmin" data-cities="@Json.Serialize(Model.ManagedCities)">
            <div class="sec-head">
                <h3>Zarządzanie</h3>
                <small>miasto: @citiesText</small>
            </div>
            <div class="card">
                <button type="button" class="btn-add" id="addPlace">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                    Dodaj miejsce
                </button>

                <form id="caForm" class="ca-form" novalidate hidden>
                    <label class="fld">
                        <span>Nazwa</span>
                        <input name="pname" maxlength="100" placeholder="np. Pałac Branickich">
                    </label>
                    <div class="row">
                        <label class="fld">
                            <span>Kategoria</span>
                            <select name="cat"></select>
                        </label>
                        <label class="fld">
                            <span>Województwo</span>
                            <input name="region" disabled>
                        </label>
                    </div>
                    <label class="fld">
                        <span>Miasto</span>
                        <select name="city"></select>
                    </label>
                    <label class="fld">
                        <span>Opis</span>
                        <textarea name="desc" rows="3" maxlength="500" placeholder="Krótki opis miejsca"></textarea>
                    </label>
                    <div class="row">
                        <label class="fld">
                            <span>Szerokość (lat)</span>
                            <input name="lat" inputmode="decimal">
                        </label>
                        <label class="fld">
                            <span>Długość (lon)</span>
                            <input name="lon" inputmode="decimal">
                        </label>
                    </div>
                    <p class="msg" id="caMsg"></p>
                    <div class="bar">
                        <button type="button" class="btn" id="caPick">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/>
                                <circle cx="12" cy="9.5" r="2.5"/>
                            </svg>
                            Wskaż na mapie
                        </button>
                        <button type="submit" class="btn dark" id="caSubmit">Dodaj</button>
                        <button type="button" class="btn" id="caCancel">Anuluj</button>
                    </div>
                </form>

                <ul class="manage-list" id="manageList"></ul>
            </div>
        </section>

        <section class="card loc">
            <div class="loc-top">
                <span class="loc-dot"></span>
                <div>
                    <small>Twoja lokalizacja</small>
                    <b id="locName"></b>
                </div>
                <button type="button" class="btn" id="myLoc">Moja lokalizacja</button>
            </div>
            <div class="loc-bottom">
                <select id="citySel" aria-label="Miasto"></select>
                <div class="seg" id="radius">
                    <button type="button" data-km="25">25 km</button>
                    <button type="button" data-km="50" class="on">50 km</button>
                </div>
            </div>
        </section>

        <label class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round">
                <circle cx="11" cy="11" r="6.5"/>
                <path d="m20 20-4.2-4.2"/>
            </svg>
            <input id="q" type="search" placeholder="Szukaj: natura, góry, zamki, Kraków…" autocomplete="off">
        </label>
        <div class="chips" id="chips"></div>

        <div class="sec-head">
            <h3>Najpopularniejsze w okolicy</h3>
            <small>przewiń →</small>
        </div>
        <div class="rail" id="popular"></div>

        <div class="sec-head">
            <h3>Ulubione</h3>
            <small id="favCount"></small>
        </div>
        <div class="rail" id="favs"></div>
    </aside>
}
else
{
    <aside class="panel">
        <a class="brand" asp-controller="Home" asp-action="Index">Podróże Małe i Duże</a>
        <p class="who">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span>Zalogowano: <b>@User.Identity.Name</b></span>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Zaloguj się</a>
            }
        </p>

        <h1>Mapa miejsc</h1>
        <p class="count" id="count"></p>

        <input id="q" type="search" placeholder="Szukaj: natura, góry, zamki, Kraków…" autocomplete="off">
        <div class="chips" id="chips"></div>
        <ul class="list" id="list"></ul>

        @if (User.IsInRole(Roles.Admin))
        {
            <section class="admin">
                <h3>Zarządzanie</h3>
                <small>tylko administrator</small>
                <form id="placeForm" novalidate>
                    <input name="pname" maxlength="100" placeholder="Nazwa, np. Zamek w Pszczynie">
                    <div class="row">
                        <select name="cat"></select>
                        <input name="region" maxlength="50" placeholder="Województwo">
                    </div>
                    <input name="city" maxlength="100" placeholder="Miasto">
                    <textarea name="desc" rows="3" maxlength="500" placeholder="Krótki opis miejsca"></textarea>
                    <div class="row">
                        <input name="lat" placeholder="Szerokość (lat)">
                        <input name="lon" placeholder="Długość (lon)">
                    </div>
                    <p id="msg"></p>
                    <div class="bar">
                        <button type="button" class="btn" id="pickBtn">Wskaż na mapie</button>
                        <button type="submit" class="btn dark">Dodaj</button>
                    </div>
                </form>
            </section>
        }
    </aside>
}

@section Scripts {
    <script src="~/js/map.js" asp-append-version="true"></script>
}
